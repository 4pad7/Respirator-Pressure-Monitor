<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="臺中榮民總醫院"
            android:textColor="#1A73E8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="呼吸面罩壓力監測與動態調參 APP"
            android:textColor="#555555"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <!-- 🚨 醫療級藍牙連線狀態指示燈卡片 -->
        <LinearLayout
            android:id="@+id/layoutStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFEBEE"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:elevation="3dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvStatusLed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴"
                android:textSize="24sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="藍牙連線已斷開！"
                    android:textColor="#C62828"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="點擊此處重新搜尋裝置 (超過10秒響起警告音)"
                    android:textColor="#B71C1C"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ⚙️ 病患與病房資訊 + 動態調參設定卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ 病房病患資訊與警報門檻設定"
                android:textColor="#1565C0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- 病房號輸入框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="病房/床號 (例: BED01):"
                    android:textColor="#333333"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etWard"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:hint="選填病房"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@android:drawable/editbox_background" />
            </LinearLayout>

            <!-- 病人號輸入框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="病患編號 (例: P12345):"
                    android:textColor="#333333"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etPatientId"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:hint="選填病人號"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@android:drawable/editbox_background" />
            </LinearLayout>

            <!-- 性別選擇下拉選單 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="病患性別:"
                    android:textColor="#333333"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spGender"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <!-- 壓力門檻 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="壓力警戒門檻 (mmHg):"
                    android:textColor="#333333"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etThreshold"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="32.0"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@android:drawable/editbox_background" />
            </LinearLayout>

            <!-- 超壓時間 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="持續超壓時間 (秒):"
                    android:textColor="#333333"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etDuration"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="1.0"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@android:drawable/editbox_background" />
            </LinearLayout>

            <Button
                android:id="@+id/btnApplySettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="套用設定並同步 SD 卡檔名與門檻"
                android:backgroundTint="#1A73E8"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 鼻樑 (Nose Bridge) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="鼻樑 (Nose Bridge) - A0 處"
                android:textColor="#777777"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tvNose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.0 mmHg"
                android:textColor="#222222"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 左臉頰 (Left Cheek) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="左臉頰 (Left Cheek) - A1 處"
                android:textColor="#777777"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tvLeftCheek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.0 mmHg"
                android:textColor="#222222"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 右臉頰 (Right Cheek) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="右臉頰 (Right Cheek) - A2 處"
                android:textColor="#777777"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tvRightCheek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.0 mmHg"
                android:textColor="#222222"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 下巴 (Chin) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下巴 (Chin) - A6 處"
                android:textColor="#777777"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tvChin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.0 mmHg"
                android:textColor="#222222"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>