<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="臺中榮民總醫院"
            android:textColor="#1A73E8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="呼吸面罩 4 點壓力即時監測 APP"
            android:textColor="#555555"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <!-- 鼻樑 (Nose Bridge) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="14dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="鼻樑 (Nose Bridge) - A0 處"
                android:textColor="#777777"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvNose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.0 mmHg"
                android:textColor="#222222"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 左臉頰 (Left Cheek) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="14dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="左臉頰 (Left Cheek) - A1 處"
                android:textColor="#777777"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvLeftCheek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.0 mmHg"
                android:textColor="#222222"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 右臉頰 (Right Cheek) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="14dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="右臉頰 (Right Cheek) - A2 處"
                android:textColor="#777777"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvRightCheek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.0 mmHg"
                android:textColor="#222222"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 下巴 (Chin) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下巴 (Chin) - A6 處"
                android:textColor="#777777"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvChin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.0 mmHg"
                android:textColor="#222222"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 系統狀態列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E8F0FE"
            android:padding="16dp"
            android:elevation="1dp">
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="狀態: 尚未與面罩連線 (點選可重試)"
                android:textColor="#1976D2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>